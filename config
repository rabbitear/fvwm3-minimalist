# Iconify, Maximize, Close
Key Space WFS   4  Function Thumbnail
Key Space A     4S All (CurrentPage,!Fvwm*B*) Function Thumbnail
Key I WFS 	4  Function Thumbnail
Key I I		4  DeiconifyAndRearrange
Key I I		M  DeiconifyAndRearrange
Key Space A 	M  Function Thumbnail
Key Space I 	M  DeiconifyAndRearrange
Key Space I 	4  DeiconifyAndRearrange
Key Return I 	N  DeiconifyAndRearrange
Key M WFS  	4  Maximize 0 100
Key M WFS  	4S Maximize 100 0
Key M WFS	4C Maximize 100 100
Key Q WFSI 	4  Close

Key (st) R A 4  Resize 80c 24c
Key (urxvt) R A 4  Resize 80c 24c

# Move from window to window with keys
Key P A 4   WindowList Root c c CurrentDesk, IconifiedAtEnd, NoGeometry, \
               UseIconName, SelectOnRelease Super_L
Key N A 4   WindowList Root c c CurrentDesk, IconifiedAtEnd, NoGeometry, \
               UseIconName, SelectOnRelease Super_L
Key K A 4   Prev (AcceptsFocus, CurrentPage) Function WindowUp
Key J A 4   Next (AcceptsFocus, CurrentPage) Function WindowUp 

# Start programs
Key W A 4  Exec exec surf -z 1.8 -s "https://en.wikipedia.org/wiki/Special:Search?search=$(xclip -o -selection primary)"
Key W A 4S Exec exec surf -z 1.0 -s -i "https://en.wikipedia.org/wiki/Special:Search?search=$(xclip -o -selection primary)"
Key S A 4  StartSurf
Key S A 4S Exec exec surf -z 1.3 "https://duckduckgo.com/?kae=t&k1=-1&km=l&kt=e&q=$(xclip -o -selection primary)"
# rofi ddgr search, see ~/.fvwm/bin/ddgr_search.py
# and https://github.com/gmagno/rofi-ddgr
Key S A 4M Exec exec rofi \
            -show ddgrsearch \
            -lines 5 \
            -eh 3 \
            -modi "ddgrsearch:$HOME/.fvwm/bin/ddgr_search.py" \
            -theme-str 'window {height: 80%; width: 80%;}' 

# Toggle Functions
#Key F      A 4  Function ToggleFirefox
#Key F      A 4S Function ToggleFirefox
#Key Space  A 4M Function ToggleNotes
Key Space  A 4C Function ToggleQuickTerm
#Key G      A 4  Function ToggleGimp
Key D      A 4  Exec exec rofi -show drun
Key C      A 4  Exec exec rofi -show drun
# Toggle keys across the bottom of the screen

Key C      A 4S  Function ToggleConsole
#Key X      A 4  Function ToggleLogView
#Key C      A 4  Function ToggleQuickTerm

# Globalish keybindings
Key R A    4S Restart
Key L A    4S Exec xscreensaver-command -lock
Key I A    4S FvwmIdent
Key Y A    4  Exec exec $[FVWM_USERDIR]/bin/screenshot.sh
Key Y A	   4S Exec exec flameshot full -p $HOME/Pictures/Screenshots

Key XF86AudioRaiseVolume A N Exec exec amixer -q sset Master 5%+
Key XF86AudioLowerVolume A N Exec exec amixer -q sset Master 5%-
Key XF86AudioMute        A N Exec exec amixer -q sset Master toggle



##################
# Mouse bindings #
##################
Mouse 1 R  A Nop
Mouse 3 R  A Function ToggleQuickTerm
Mouse 1 TFS A Function RaiseOrMoveOrResizeFunc
Mouse 1 WFS 4 Move
Mouse 1 WFS M Move
#Mouse 1 T   D Function Thumbnail
Mouse 3 TFS A Function ResizeOrRaiseOrIconifyFunc
Mouse 3 I  A DeiconifyAndRearrange


