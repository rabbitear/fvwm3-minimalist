# StartFunction is executed on startups and restats.
DestroyFunc StartFunction
AddToFunc StartFunction
+ I Test (Init) Exec exec $[FVWM_USERDIR]/bin/display.sh
+ I Echo "====================="
+ I Echo "= Fvwm3 is starting ="
+ I Echo "====================="
+ I Test (Init)	Desk 0 0
+ I Test (Init) Exec exec mkdir /dev/shm/fvwmicon
+ I Test (Init) Exec exec xinput set-prop 15 "libinput Accel Profile Enabled" 0, 0, 1
+ I PipeRead 'test -d /dev/shm/fvwmicon && echo SetEnv ICON_TMPDIR /dev/shm/fvwmicon || echo SetEnv ICON_TMPDIR $[FVWM_USERDIR]'
+ I Test (X stalonetray) PipeRead 'pgrep -x "stalonetray" > /dev/null || echo Exec exec stalonetray --transparent --vertical --geometry 31x1-5+5 --grow-gravity S --icon-gravity NE --icon-size=16 --kludges=force_icons_size'
+ I Test (X dunst) PipeRead 'pgrep -x "dunst" > /dev/null || echo Exec exec dunst'
+ I Test (X nm-applet) PipeRead 'pgrep -x "nm-applet" > /dev/null || echo Exec exec nm-applet'
+ I Test (X blueman-applet) PipeRead 'pgrep -x "blueman-applet" > /dev/null || echo Exec exec blueman-applet'
+ I Test (X copyq) PipeRead 'pgrep -x "copyq" > /dev/null || echo Exec exec copyq'
+ I Test (X neochat) PipeRead 'pgrep -x "neochat" > /dev/null || echo Exec exec neochat'
+ I Test (X blueman-applet) PipeRead 'pgrep -x "blueman-applet" > /dev/null || echo Exec exec blueman-applet'
+ I Test (X xdaliclock) PipeRead 'pgrep -x "xdaliclock" > /dev/null || echo Exec exec xdaliclock -oink-oink -transparent -bw 0 -fg green -bg black -nocycle -geom -10-10'
+ I Test (init) Exec exec ~/.fvwm/bin/picom.sh
+ I Test (init) Exec exec \
    echo "Starting moe =-=-=-=-= $(date) =-=-=-=-=" > ~/.fvwm/fvwm3-output.log
+ I Exec exec feh --bg-scale ~/.fvwm/pix/wallpaper-darklake1.jpg
+ I Exec exec xset r rate 170 70
+ I Exec exec xinput set-prop "USB-HID Keyboard Mouse" 312 0, 0, 1
+ I Module FvwmButtons ButtonBox
+ I Module FvwmEvent
+ I All (Iconic) ReThumbnail

# ExitFunction is excuted when exiting or restarting before actually 
# quitting. Kill modules here
DestroyFunc ExitFunction
AddToFunc ExitFunction
+ I Test (ToRestart) KillModule FvwmEvent
+ I Test (ToRestart) KillModule ButtonBox


DestroyModuleConfig ButtonBox: *
*ButtonBox: Geometry 112x16+8+5
*ButtonBox: BoxSize fixed
*ButtonBox: Rows 1
*ButtonBox: Columns 8
*ButtonBox: Frame 0
*ButtonBox: Padding 0 0
*ButtonBox: (2x1, Action Exec exec $[FVWM_USERDIR]/bin/screenshot.sh, Swallow(kill) xeyes "Exec exec xeyes")
*ButtonBox: (6x1, Action `Menu MainMenu rectangle $widthx$height+$left+$top o+50 10m`, Swallow(kill) xclock "Exec exec \
    xclock -digital -render -padding 0 -update 1 -strftime ' %H:%M %a %b %d' \
